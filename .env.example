# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# App URL (used for OAuth redirects, email links)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Plaid
PLAID_CLIENT_ID=
PLAID_SECRET_SANDBOX=
PLAID_SECRET=
PLAID_ENV=sandbox

# Market Data
POLYGON_API_KEY=
FINNHUB_API_KEY=

# AI
OPENAI_API_KEY=

# Cron (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
CRON_SECRET=

# Subscription status reconciliation (RevenueCat API v1 app key)
REVENUECAT_API_KEY=
REVENUECAT_WEBHOOK_SECRET=

# Apple deletion reauthorization: web values must match the registered Services ID/return URL.
NEXT_PUBLIC_APPLE_WEB_CLIENT_ID=
NEXT_PUBLIC_APPLE_WEB_REDIRECT_URI=
APPLE_SIGN_IN_WEB_CLIENT_ID=
APPLE_SIGN_IN_WEB_REDIRECT_URI=
APPLE_SIGN_IN_CLIENT_ID=
APPLE_SIGN_IN_TEAM_ID=
APPLE_SIGN_IN_KEY_ID=
APPLE_SIGN_IN_PRIVATE_KEY=
