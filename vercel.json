{
  "buildCommand": "next build",
  "redirects": [
    {
      "source": "/:path(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.helmterminal.dev"
        }
      ],
      "destination": "https://helmterminal.dev/:path",
      "permanent": true
    }
  ],
  "crons": [
    {
      "path": "/api/cron/daily",
      "schedule": "15 13 * * *"
    },
    {
      "path": "/api/cron/score-theses",
      "schedule": "25 13 * * *"
    }
  ]
}
