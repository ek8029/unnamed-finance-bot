{
  "buildCommand": "next build",
  "redirects": [
    {
      "source": "/:path(.*)",
      "has": [{ "type": "host", "value": "www.helmterminal.dev" }],
      "destination": "https://helmterminal.dev/:path",
      "permanent": true
    }
  ],
  "crons": [
    {
      "path": "/api/cron/daily",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/digest",
      "schedule": "0 * * * *"
    }
  ]
}
