{
  "buildCommand": "next build",
  "redirects": [
    {
      "source": "/:path(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.helmterminal.dev"
        }
      ],
      "destination": "https://helmterminal.dev/:path",
      "permanent": true
    }
  ],
  "crons": [
    {
      "path": "/api/cron/daily?force=true",
      "schedule": "15 13 * * *"
    },
    {
      "path": "/api/cron/score-theses",
      "schedule": "0 13-21 * * 1-5"
    },
    {
      "path": "/api/cron/content",
      "schedule": "30 21 * * 1-5"
    },
    {
      "path": "/api/cron/intraday-prices",
      "schedule": "*/5 13-21 * * 1-5"
    },
    {
      "path": "/api/cron/prices?run=close",
      "schedule": "5 20 * * 1-5"
    },
    {
      "path": "/api/cron/prices?run=late",
      "schedule": "0 23 * * 1-5"
    },
    {
      "path": "/api/cron/snapshots",
      "schedule": "0 */6 * * *"
    },
    {
      "path": "/api/cron/citation-probe",
      "schedule": "0 14 * * 1"
    }
  ]
}
